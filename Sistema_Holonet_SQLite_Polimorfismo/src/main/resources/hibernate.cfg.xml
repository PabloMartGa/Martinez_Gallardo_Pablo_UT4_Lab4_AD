<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-configuration PUBLIC
        "-//Hibernate/Hibernate Configuration DTD 3.0//EN"
        "http://www.hibernate.org/dtd/hibernate-configuration-3.0.dtd">
<hibernate-configuration>
    <session-factory>

        <!-- ===== Conexión a SQLite (base de datos embebida en el fichero holonet.db) ===== -->
        <property name="hibernate.connection.driver_class">org.sqlite.JDBC</property>
        <!--
            - holonet.db es una ruta RELATIVA: se resuelve desde la carpeta del proyecto
              (donde está pom.xml). Es la carpeta de trabajo tanto con "mvn exec:java"
              como al pulsar Run en NetBeans.
            - foreign_keys=on es IMPORTANTE: SQLite trae las claves foráneas DESACTIVADAS
              por defecto en cada conexión. Sin esto, ON DELETE CASCADE / SET NULL y las
              comprobaciones de FK no se aplicarían.
        -->
        <property name="hibernate.connection.url">jdbc:sqlite:holonet.db?foreign_keys=on</property>

        <!-- SQLite es un único fichero con un único escritor: una sola conexión evita "database is locked" -->
        <property name="hibernate.connection.pool_size">1</property>

        <!-- ===== Dialecto (viene de hibernate-community-dialects) ===== -->
        <property name="hibernate.dialect">org.hibernate.community.dialect.SQLiteDialect</property>

        <!--
            ===== Esquema =====
            update   -> no toca lo que ya existe; si falta algo, lo crea (tolerante).
            validate -> solo comprueba que las entidades casan con las tablas y lanza
                        excepción si no coinciden (más estricto; también permitido en el enunciado).
        -->
        <property name="hibernate.hbm2ddl.auto">update</property>

        <!-- ===== Depuración: ver el SQL que genera Hibernate ===== -->
        <property name="hibernate.show_sql">true</property>
        <property name="hibernate.format_sql">false</property>

        <!-- ===== Entidades mapeadas ===== -->
        <mapping class="ut4.sqlite.modelo.Planeta"/>
        <mapping class="ut4.sqlite.modelo.Nave"/>
        <mapping class="ut4.sqlite.modelo.CazaLigero"/>
        <mapping class="ut4.sqlite.modelo.DestructorEstelar"/>

    </session-factory>
</hibernate-configuration>